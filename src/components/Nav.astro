---
const links = [
  { label: "The Offer", href: "/offer" },
  { label: "Proof", href: "/proof" },
  { label: "Founder", href: "/founder" },
  { label: "Blog", href: "/blog" },
];
---

<header class="sticky top-0 z-50 border-b border-hairline bg-obsidian/85 backdrop-blur-sm">
  <nav class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4">
    <a href="/" class="flex items-center gap-2.5">
      <span
        aria-hidden="true"
        class="block h-5 w-5 [clip-path:polygon(50%_0%,100%_20%,100%_65%,50%_100%,0%_65%,0%_20%)]"
        style="background: linear-gradient(135deg, var(--color-gold-deep), var(--color-gold-light) 40%, #fff3d2 52%, var(--color-gold) 65%, var(--color-gold-deep));"
      ></span>
      <span class="font-display text-base font-bold tracking-tight text-ink">KHUN CAMP</span>
    </a>

    <ul class="hidden items-center gap-8 font-body text-sm text-ink-dim md:flex">
      {links.map((link) => (
        <li>
          <a href={link.href} class="transition-colors hover:text-ink">{link.label}</a>
        </li>
      ))}
    </ul>

    <div class="hidden items-center md:flex">
      <a
        href="/contact"
        class="rounded-sm px-5 py-2.5 font-body text-sm font-semibold text-obsidian"
        style="background: linear-gradient(135deg, var(--color-silver-deep), var(--color-silver-light) 35%, #cfd3d5 55%, var(--color-silver) 80%);"
      >
        Book a Call
      </a>
    </div>

    <button
      id="nav-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="nav-mobile-menu"
      aria-label="Toggle menu"
      class="flex h-9 w-9 items-center justify-center md:hidden"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="text-ink">
        <path d="M3 6h18M3 12h18M3 18h18" stroke-linecap="round" />
      </svg>
    </button>
  </nav>

  <div id="nav-mobile-menu" class="hidden border-t border-hairline px-6 pb-6 md:hidden">
    <ul class="flex flex-col gap-4 pt-5 font-body text-base text-ink-dim">
      {links.map((link) => (
        <li>
          <a href={link.href} class="transition-colors hover:text-ink">{link.label}</a>
        </li>
      ))}
    </ul>
    <a
      href="/contact"
      class="mt-5 block rounded-sm px-5 py-3 text-center font-body text-sm font-semibold text-obsidian"
      style="background: linear-gradient(135deg, var(--color-silver-deep), var(--color-silver-light) 35%, #cfd3d5 55%, var(--color-silver) 80%);"
    >
      Book a Call
    </a>
  </div>
</header>

<script>
  const toggle = document.getElementById("nav-toggle");
  const menu = document.getElementById("nav-mobile-menu");
  toggle?.addEventListener("click", () => {
    const isOpen = menu?.classList.toggle("hidden") === false;
    toggle.setAttribute("aria-expanded", String(isOpen));
  });
</script>

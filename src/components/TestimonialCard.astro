---
interface Props {
  quote: string;
  name: string;
  role: string;
}
const { quote, name, role } = Astro.props;
---

<figure class="flex h-full flex-col rounded-sm border border-hairline bg-obsidian-surface p-6">
  <div class="mb-4 flex gap-0.5 text-gold" aria-hidden="true">
    {Array.from({ length: 5 }).map(() => (
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-3.5 w-3.5">
        <path d="M10 1.5l2.6 5.6 6.1.6-4.6 4.1 1.3 6-5.4-3.1-5.4 3.1 1.3-6-4.6-4.1 6.1-.6z" />
      </svg>
    ))}
  </div>
  <blockquote class="flex-1 font-body text-sm leading-relaxed text-ink-dim">
    "{quote}"
  </blockquote>
  <figcaption class="mt-5 font-body text-sm">
    <span class="font-semibold text-ink">{name}</span>
    <span class="text-ink-faint"> · {role}</span>
  </figcaption>
</figure>

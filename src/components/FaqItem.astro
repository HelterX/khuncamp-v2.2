---
interface Props {
  question: string;
}
---

<details class="group border-b border-hairline py-5">
  <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-body text-base text-ink marker:content-none">
    <span>{Astro.props.question}</span>
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
      class="h-4 w-4 shrink-0 text-ink-faint transition-transform duration-200 group-open:rotate-45">
      <path d="M12 5v14M5 12h14" stroke-linecap="round" />
    </svg>
  </summary>
  <p class="mt-3 max-w-[65ch] font-body text-sm leading-relaxed text-ink-dim">
    <slot />
  </p>
</details>
